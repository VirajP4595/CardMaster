<?xml version="1.0" encoding="utf-8"?>
<!-- No cloud backup and no device-to-device copy (rule R2). The database key
     lives in this phone's Keystore, so a copied database couldn't be opened
     anyway; the encrypted export file is the only way to move data. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root"/>
        <exclude domain="file"/>
        <exclude domain="database"/>
        <exclude domain="sharedpref"/>
        <exclude domain="external"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="root"/>
        <exclude domain="file"/>
        <exclude domain="database"/>
        <exclude domain="sharedpref"/>
        <exclude domain="external"/>
    </device-transfer>
</data-extraction-rules>
